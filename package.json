{
  "name": "gifttube",
  "version": "0.1.0",
  "description": "Premura — agente AI concierge per host italiani di affitti brevi",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @premura/api dev",
    "dev:web": "pnpm --filter @premura/web dev",
    "build": "pnpm -r --parallel build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx packages/db/src/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.30.0",
    "postgres": "3",
    "testcontainers": "^10.16.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
