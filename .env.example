# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# URL pubblico dell'app Next.js. Usato per costruire l'OAuth redirect URI
# (${APP_URL}/api/auth/google/callback). In produzione: https://premura.it
APP_URL=http://localhost:3000

# Database (Postgres direct connection — usata da Drizzle + drizzle-kit)
# In Supabase: direct URL port 5432 per migrations, pooler 6543 per app runtime
DATABASE_URL=postgresql://premura:devpassword@localhost:5432/premura_dev

# Redis (queue BullMQ per polling iCal e job futuri).
# Per dev locale, scegli una delle opzioni:
#  1. Fly Redis (consigliato: stesso ecosistema di apps/api, `fly redis create`)
#  2. Upstash diretto (free tier, accesso via TLS, rediss://...)
#  3. Docker locale (`docker run -p 6379:6379 redis:7-alpine`)
# In produzione: connection string del Redis gestito (Fly/Upstash/etc).
# NON committare URL reali con credenziali.
REDIS_URL=redis://localhost:6379

# Google OAuth (milestone M2a.3 — Connetti Gmail)
# Client web application creato su https://console.cloud.google.com/auth/clients
# Redirect URI già registrati: localhost:3000, premura.it, premura-web.vercel.app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chiave simmetrica a 32 byte usata per:
# 1. AES-256-GCM dei token OAuth persistiti (access + refresh)
# 2. HMAC SHA-256 (jose HS256) del JWT di state CSRF (TTL 10 min)
# Genera con: openssl rand -base64 32
# NON committare mai il valore reale. Rotazione: pianificata pre-launch.
TOKEN_ENCRYPTION_KEY=

# DEV_HOST_ID — UUID dell'host di test (Andrea), leggibile da seed.ts
# in packages/db. Temporaneo finché non c'è auth reale (M2a.2).
# Leggi da env, NON hardcodare.
DEV_HOST_ID=

# ALLOW_DEV_HOST — escape hatch per la dashboard slice 5.
# Se NODE_ENV=production, lib/auth.ts blocca getCurrentHostId() a meno che
# questa sia '1'. Utile per smoke test su staging Vercel prima di slice 6
# (Supabase Auth). In dev locale lascia vuoto.
ALLOW_DEV_HOST=

# API_URL / NEXT_PUBLIC_API_URL — base URL dell'API Fastify (apps/api).
# La dashboard slice 5 chiama solo le mutazioni (complete-manual,
# skip-completion); le letture viaggiano via Drizzle diretto.
# Server-side preferisce API_URL; il fallback NEXT_PUBLIC_API_URL e' utile
# se in futuro aggiungiamo client component che chiamano l'API.
API_URL=https://premura-api-staging.fly.dev
NEXT_PUBLIC_API_URL=https://premura-api-staging.fly.dev

# Supabase (gestito: auth, storage, realtime, REST via PostgREST)
SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable (anon) key — esponibile al browser, soggetta a RLS
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret (service_role) key — SOLO backend, bypassa RLS
SUPABASE_SECRET_KEY=sb_secret_xxx

# Claude / Anthropic
# ANTHROPIC_API_KEY: chiave API per chiamare Claude.
# Usata da apps/web per il parser email Airbnb (M2a.3 Fase 2) e in futuro
# per Guest DNA, Conversation Agent, Message Writer.
# Genera su https://console.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# Modelli Claude. NON hardcodare nei file: leggi sempre da env.
# - PRIMARY: decisioni alta qualità (Guest DNA, escalation routing).
# - FAST: classifier intent / task semplici (~5× più economico di Opus).
# - EMAIL_PARSER: parser email Airbnb/Booking (M2a.3 Fase 2). Sonnet 4.6
#   è ~4× più economico di Opus, qualità sufficiente per extraction.
#   Costo stimato: ~$0.016 per email parsata (~€3 per 200 email).
CLAUDE_MODEL_PRIMARY=claude-opus-4-7
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001
CLAUDE_MODEL_EMAIL_PARSER=claude-sonnet-4-6

# Booking.com Connectivity
BOOKING_API_URL=https://supply-xml.booking.com/hotels/xml
BOOKING_USERNAME=
BOOKING_PASSWORD=

# Airbnb
AIRBNB_API_KEY=
AIRBNB_CLIENT_ID=
AIRBNB_CLIENT_SECRET=

# Amazon SP-API (Italia marketplace)
AMAZON_SP_CLIENT_ID=
AMAZON_SP_CLIENT_SECRET=
AMAZON_SP_REFRESH_TOKEN=
AMAZON_MARKETPLACE_ID=APJ6JRA9NG5V4

# Cortilia
CORTILIA_API_KEY=

# Glovo Business
GLOVO_API_KEY=
GLOVO_WEBHOOK_SECRET=

# WhatsApp Business Cloud
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SUBSCRIPTION_PRICE_ID=price_xxx

# Security
JWT_SECRET=change-me-to-random-64-char-string
ENCRYPTION_KEY=change-me-to-random-32-byte-hex
